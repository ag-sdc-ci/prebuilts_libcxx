package {
    default_applicable_licenses: ["external_libcxx_license"],
}

license {
    name: "external_libcxx_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-MIT",
        "SPDX-license-identifier-NCSA",
    ],
    license_text: [
        "LICENSE.TXT",
    ],
}

cc_defaults {
    name: "libc++ defaults",
    host_supported: true,
    export_include_dirs: ["include"],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
    cppflags: [
        "-std=c++14",
        "-fexceptions",
        "-DLIBCXX_BUILDING_LIBCXXABI",
        "-D_LIBCPP_BUILDING_LIBRARY",
    ],
    rtti: true,
    stl: "none",
    target: {
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
            cflags: [
                "-D_LIBCPP_HAS_THREAD_API_WIN32",
                "-D_LIBCXXABI_BUILDING_LIBRARY",
                "-D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS",
                "-D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS",
                "-UWIN32_LEAN_AND_MEAN",
            ],
        },
    },
}

// host + device static lib
cc_prebuilt_library_static {
    name: "libc++_static",
    defaults: ["libc++ defaults"],
    vendor_available: true,
    product_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "apex_inherit",
    sdk_version: "current",
    native_bridge_supported: true,
    prefer: true,
    compile_multilib: "both",
    whole_static_libs: [
        "libc++abi",
    ],
    target: {
        android_arm: {
            srcs: ["target/arm/lib/libc++_static.a"],
        },
        android_arm64: {
            srcs: ["target/aarch64/lib/libc++_static.a"],
        },
        android_x86: {
            srcs: ["target/i386/lib/libc++_static.a"],
        },
        android_x86_64: {
            srcs: ["target/x86_64/lib/libc++_static.a"],
        },
        android_riscv64: {
            srcs: ["target/riscv64/lib/libc++_static.a"],
        },
        linux_glibc_x86: {
            srcs: ["host/i386-unknown-linux-gnu/libc++.a"],
        },
        linux_glibc_x86_64: {
            srcs: ["host/x86_64-unknown-linux-gnu/libc++.a"],
        },
        linux_musl_x86: {
            srcs: ["host/i686-unknown-linux-musl/libc++.a"],
        },
        linux_musl_x86_64: {
            srcs: ["host/x86_64-unknown-linux-musl/libc++.a"],
        },
        linux_musl_arm: {
            srcs: ["host/arm-unknown-linux-musleabihf/libc++.a"],
        },
        linux_musl_arm64: {
            srcs: ["host/aarch64-unknown-linux-musl/libc++.a"],
        },
        windows_x86: {
            srcs: ["host/i686-w64-windows-gnu/libc++.a"],
        },
        windows_x86_64: {
            srcs: ["host/x86_64-w64-windows-gnu/libc++.a"],
        },
    },
}

// host + device dynamic lib
cc_prebuilt_library_shared {
    name: "libc++",
    host_supported: true,
    vendor_available: true,
    product_available: true,
    native_bridge_supported: true,
    vndk: {
        enabled: true,
        support_system_process: true,
    },
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "apex_inherit",
    sdk_version: "current",
    stl: "none",
    prefer: true,
    compile_multilib: "both",
    export_include_dirs: ["include"],
    check_elf_files: false,
    target: {
        android_arm: {
            srcs: ["target/arm/lib/libc++.so"],
        },
        android_arm64: {
            srcs: ["target/aarch64/lib/libc++.so"],
        },
        android_x86: {
            srcs: ["target/i386/lib/libc++.so"],
        },
        android_x86_64: {
            srcs: ["target/x86_64/lib/libc++.so"],
        },
        android_riscv64: {
            srcs: ["target/riscv64/lib/libc++.so"],
        },
        linux_glibc_x86: {
            srcs: ["host/i386-unknown-linux-gnu/libc++.so"],
        },
        linux_glibc_x86_64: {
            srcs: ["host/x86_64-unknown-linux-gnu/libc++.so"],
        },
        linux_musl_x86: {
            srcs: ["host/i686-unknown-linux-musl/libc++.so"],
        },
        linux_musl_x86_64: {
            srcs: ["host/x86_64-unknown-linux-musl/libc++.so"],
        },
        linux_musl_arm: {
            srcs: ["host/arm-unknown-linux-musleabihf/libc++.so"],
        },
        linux_musl_arm64: {
            srcs: ["host/aarch64-unknown-linux-musl/libc++.so"],
        },
    },
}

cc_prebuilt_library_static {
    name: "libc++experimental",
    defaults: ["libc++ defaults"],
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    prefer: true,
    compile_multilib: "both",
    target: {
        android_arm: {
            srcs: ["clang-r510928/android_libc++/ndk/arm/lib/libc++experimental.a"],
        },
        android_arm64: {
            srcs: ["clang-r510928/android_libc++/ndk/aarch64/lib/libc++experimental.a"],
        },
        android_x86: {
            srcs: ["clang-r510928/android_libc++/ndk/i386/lib/libc++experimental.a"],
        },
        android_x86_64: {
            srcs: ["clang-r510928/android_libc++/ndk/x86_64/lib/libc++experimental.a"],
        },
        android_riscv64: {
            srcs: ["clang-r510928/android_libc++/ndk/riscv64/lib/libc++experimental.a"],
        },
        linux_glibc_x86: {
            srcs: ["host/i386-unknown-linux-gnu/libc++experimental.a"],
        },
        linux_glibc_x86_64: {
            srcs: ["host/x86_64-unknown-linux-gnu/libc++experimental.a"],
        },
        linux_musl_x86: {
            srcs: ["host/i686-unknown-linux-musl/libc++experimental.a"],
        },
        linux_musl_x86_64: {
            srcs: ["host/x86_64-unknown-linux-musl/libc++experimental.a"],
        },
        linux_musl_arm: {
            srcs: ["host/arm-unknown-linux-musleabihf/libc++experimental.a"],
        },
        linux_musl_arm64: {
            srcs: ["host/aarch64-unknown-linux-musl/libc++experimental.a"],
        },
    },
}

cc_library {
    name: "libc++fs",
    defaults: ["libc++ defaults"],
    host_supported: true,
    ramdisk_available: true,
    recovery_available: true,
    vendor_available: true,
    shared_libs: ["libc++"],
    whole_static_libs: ["libc++_static"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "apex_inherit",
    target: {
        windows: {
            enabled: false,
        },
    },
}

// Export libc++ headers for inclusion in the musl sysroot.
genrule {
    name: "libc_musl_sysroot_libc++_headers",
    visibility: ["//external/musl"],
    srcs: [
        "LICENSE.TXT",
        "NOTICE",
        "include/**/*",
        "dev-src/libcxxabi-include/*.h",
    ],
    out: ["libc_musl_sysroot_libc++_headers.zip"],
    tools: [
        "soong_zip",
        "zip2zip",
    ],
    cmd: "LIBCXX_DIR=$$(dirname $(location NOTICE)) && " +
        "$(location soong_zip) -o $(genDir)/sysroot.zip -symlinks=false" +
        // NOTICE
        " -j -f $(location NOTICE) " +
        // headers
        " -P include/c++ " +
        "  -C $${LIBCXX_DIR}/include " +
        "  -D $${LIBCXX_DIR}/include " +
        " && " +
        "$(location zip2zip) -i $(genDir)/sysroot.zip -o $(out) " +
        " -x include/c++/CMakeLists.txt" +
        " -x include/c++/module.modulemap " +
        " include/**/*:include " +
        " NOTICE:NOTICE.libc++",
}
